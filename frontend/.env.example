# FairDrop app - copy to .env.local
# The DEMO instance: same source as canonical; the operator may file on behalf
# of a named public wallet and windows are minutes. This is what the app drives.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# The CANONICAL instance: sender must be the wallet, 48h contest window.
NEXT_PUBLIC_CANONICAL_ADDRESS=0x0000000000000000000000000000000000000000
# FairDropRegistry: is_cleared(wallet, drop_id). Holds no funds.
NEXT_PUBLIC_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_GENLAYER_NETWORK=studio-dev
